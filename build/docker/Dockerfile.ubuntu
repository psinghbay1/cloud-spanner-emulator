################################################################################
#                                     BUILD                                    #
################################################################################

FROM ubuntu:22.04 as build

# Perform all APT installs in a single layer to reduce image size.
ENV GCC_VERSION=13
ARG DEBIAN_FRONTEND="noninteractive"
ARG TZ="America/Los_Angeles"
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    tar \
    wget \
    zip \
    unzip \
    git \
    make \
    rename \
    software-properties-common \
    gnupg \
    build-essential \
    ca-certificates \
    libgnutls30 \
    tzdata \
    language-pack-en \
    default-jre \
    default-jdk \
    protobuf-compiler \
    python3 \
    && add-apt-repository ppa:ubuntu-toolchain-r/test -y \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       gcc-${GCC_VERSION} \
       g++-${GCC_VERSION} \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-${GCC_VERSION} 90 \
       --slave /usr/bin/g++ g++ /usr/bin/g++-${GCC_VERSION} \
    && apt-get install -y --no-install-recommends --only-upgrade libstdc++6

# Create a symlink so 'python' points to 'python3'
RUN ln -s /usr/bin/python3 /usr/bin/python

# Install Bazelisk
ENV USE_BAZEL_VERSION=7.6.1
ARG TARGETARCH
RUN wget -O /usr/local/bin/bazel https://github.com/bazelbuild/bazelisk/releases/download/v1.17.0/bazelisk-linux-${TARGETARCH} \
    && chmod +x /usr/local/bin/bazel

# Build GoogleSQL to cache it for reuse in subsequent Docker builds.
# GoogleSQL can take 3h+ to build, so caching it saves a lot of time.
WORKDIR /src
COPY build/bazel build/bazel/
COPY MODULE.bazel MODULE.bazel.lock* .bazelversion .bazelrc BUILD.bazel \
    requirements.txt go.mod go.sum ./

# .bazelrc sets --jobs=auto, which sizes parallelism to CPU count and ignores
# memory. Compiling GoogleSQL runs many cc1plus processes that each need ~1-2 GB,
# so on a Docker VM with less RAM than (cores x 2 GB) the build dies with
# "gcc: fatal error: Killed signal terminated program cc1plus" and
# "ResourceExhausted: cannot allocate memory".
#
# BAZEL_JOBS caps it. Leave empty to keep upstream behaviour.
ARG BAZEL_JOBS=""
ENV BAZEL_JOBS_ARG=${BAZEL_JOBS:+--jobs=${BAZEL_JOBS}}

# GoogleSQL's tm_parser.cc is a bison-generated parser compiled as one
# translation unit; at -O2 a single cc1plus peaks around 8-10 GB and is
# OOM-killed on a modest VM. GCC_MEMORY_COPTS makes GCC's garbage collector run
# far more aggressively, which cuts peak RSS without changing generated code
# (unlike lowering -O, which would).
#
#   ggc-min-expand=10    collect once the heap grows 10% (default scales to 100%)
#   ggc-min-heapsize     start collecting from 32 MB rather than much later
#   -fno-var-tracking*   skip costly debug-location tracking (-g0 is set anyway)
#
# Empty by default so upstream behaviour is unchanged.
ARG GCC_MEMORY_COPTS=""
ENV GCC_MEMORY_ARGS=${GCC_MEMORY_COPTS:+${GCC_MEMORY_COPTS}}

# A Bazel disk cache, mounted from the host as a BuildKit cache mount, survives
# Docker layer invalidation. Without it, editing MODULE.bazel or .bazelrc forces
# a full GoogleSQL rebuild (~2h); with it, Bazel reuses the compiled artifacts
# and the same edit costs minutes. The mount is not part of the image, so the
# published image is unchanged.
ENV BAZEL_DISK_CACHE=/root/.cache/bazel-disk
RUN --mount=type=cache,target=/root/.cache/bazel-disk,sharing=locked \
    bazel build -c opt ${BAZEL_JOBS_ARG} ${GCC_MEMORY_ARGS} \
    --disk_cache=${BAZEL_DISK_CACHE} \
    @com_google_googlesql//googlesql/public:value \
    @com_google_googlesql//googlesql/public:analyzer

# Copy over the emulator code base into the container.
COPY . .

# Make enum NodeTag compatible with both C and C++.
RUN find third_party/spanner_pg -name "nodes.h" -exec sed -i 's/enum NodeTag : int/enum NodeTag/g' {} +

# Build the emulator binaries only.
# Since we are only copying the binaries to the release image, we don't need to
# build the rest of the targets.
ENV EXTRA_BAZEL_ARGS="--tool_java_runtime_version=local_jdk"
RUN --mount=type=cache,target=/root/.cache/bazel-disk,sharing=locked \
    bazel build -c opt ${BAZEL_JOBS_ARG} ${GCC_MEMORY_ARGS} \
    --disk_cache=${BAZEL_DISK_CACHE} \
    //binaries:emulator_main \
    //binaries:gateway_main

# Generate licenses file.
RUN for file in $(find -L bazel-src/external                               \
                       -name "LICENSE" -o -name "COPYING")                   ; \
    do                                                                         \
      echo "----"                                                            ; \
      echo $file                                                             ; \
      echo "----"                                                            ; \
      cat $file                                                              ; \
    done > licenses.txt                                                     && \
    gzip licenses.txt

################################################################################
#                                   RELEASE                                    #
################################################################################

# Now build the release image from the build image.
FROM gcr.io/distroless/cc-debian12

# Copy binaries.
COPY --from=build /src/bazel-bin/binaries/emulator_main .
COPY --from=build /src/bazel-bin/binaries/gateway_main_/gateway_main .

# Copy the libstdc++.so.6 shared library. We use wildcards to execute a conditional
# copy depending on the target architecture.
COPY --from=build /usr/lib/x86_64-linux-gnu*/libstdc++.so.6 /usr/lib/x86_64-linux-gnu
COPY --from=build /usr/lib/aarch64-linux-gnu*/libstdc++.so.6 /usr/lib/aarch64-linux-gnu

# Copy licenses
COPY --from=build /src/licenses.txt.gz .

# Expose the default ports 9010 (gRPC) and 9020 (REST)
EXPOSE 9010 9020

# Run the gateway process, bind to 0.0.0.0 as under MacOS, listening on
# localhost will make the server invisible outside the container.
CMD ["./gateway_main", "--hostname", "0.0.0.0"]
